<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia core packages -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    
    <!-- Community Toolkit MVVM -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- SkiaSharp for Image Generation/Handling -->
    <PackageVersion Include="SkiaSharp" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />

    <!-- OpenCvSharp for Image Processing -->
    <PackageVersion Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />

    <!-- PaddleOCR for deep learning OCR benchmark -->
    <PackageVersion Include="Sdcb.PaddleOCR" Version="3.3.1" />
    <PackageVersion Include="Sdcb.PaddleOCR.Models.Local" Version="3.3.1" />
    <PackageVersion Include="Sdcb.PaddleInference.runtime.win64.openblas" Version="3.3.1.70" />

    <!-- Dependency Injection -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.2" />

    <!-- Configuration packages -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="9.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.2" />

    <!-- Serilog Logging -->
    <PackageVersion Include="Serilog" Version="4.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />

    <!-- Data Protection (Windows Cryptography DPAPI) -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="9.0.2" />

    <!-- Database (SQLite) -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.2" />

    <!-- Windows Drawing Support -->
    <PackageVersion Include="System.Drawing.Common" Version="9.0.2" />

    <!-- Testing packages -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
