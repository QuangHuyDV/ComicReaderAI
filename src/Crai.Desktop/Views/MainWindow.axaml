<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Crai.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="700"
        x:Class="Crai.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CRAI Reader Side Panel"
        Width="380" Height="700"
        CanResize="True"
        Topmost="True"
        WindowDecorations="BorderOnly"
        Background="#121212">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <!-- 1. Header & Status Bar -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="COMIC READER AI" 
                           FontSize="18" FontWeight="Bold" Foreground="#3A86FF" 
                           LetterSpacing="1"/>
                <Button Grid.Column="1" Content="✕" Click="CloseButton_Click"
                        Background="Transparent" BorderBrush="Transparent" Foreground="#FF5555"
                        Padding="6,2" FontSize="14" FontWeight="Bold"/>
            </Grid>
            
            <Border Background="#1E1E1E" CornerRadius="8" Padding="12,8" BorderThickness="1" BorderBrush="#2D2D2D">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" 
                               Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1" IsIndeterminate="True" 
                                 IsVisible="{Binding IsLoading}" 
                                 Width="20" Height="20"
                                 VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 2. Content Areas (Original vs Translated) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <!-- Original Text Section -->
                <StackPanel Spacing="6">
                    <TextBlock Text="VĂN BẢN GỐC" FontSize="11" FontWeight="Bold" Foreground="#666666" LetterSpacing="0.5"/>
                    <Border Background="#1A1A1A" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#252525">
                        <TextBlock Text="{Binding OriginalText}" 
                                   Foreground="#888888" FontSize="13" 
                                   TextWrapping="Wrap" LineHeight="18"/>
                    </Border>
                </StackPanel>

                <!-- Translated Text Section -->
                <StackPanel Spacing="6">
                    <TextBlock Text="BẢN DỊCH" FontSize="11" FontWeight="Bold" Foreground="#3A86FF" LetterSpacing="0.5"/>
                    <Border Background="#252525" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="#333333">
                        <TextBlock Text="{Binding TranslatedText}" 
                                   Foreground="#FFFFFF" FontSize="15" FontWeight="Normal"
                                   TextWrapping="Wrap" LineHeight="22"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Controls / Translation Button -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0" Spacing="8">
            <Button Command="{Binding TriggerTranslationCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#3A86FF" Foreground="White" Padding="16"
                    CornerRadius="8" FontSize="14" FontWeight="Bold">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="DỊCH MÀN HÌNH"/>
                    <TextBlock Text="(Ctrl+Shift+T)" Foreground="#B5D2FF" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="Mẹo: Click giữ kéo viền để thay đổi kích thước Side Panel." 
                       HorizontalAlignment="Center" Foreground="#444444" FontSize="10"/>
        </StackPanel>
    </Grid>
</Window>
