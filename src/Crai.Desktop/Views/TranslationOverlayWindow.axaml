<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Crai.Desktop.Views.TranslationOverlayWindow"
        Title="CRAI Translation Overlay"
        WindowState="Maximized"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False">

    <!-- Grid chính bao phủ toàn bộ màn hình, click vào là đóng ngay -->
    <Grid Name="MainGrid" Background="#01000000" PointerPressed="OnBackgroundClicked">
        <!-- Canvas chứa các nhãn chữ dịch đè -->
        <Canvas Name="OverlayCanvas" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        
        <!-- Nút Close nhanh ở góc trên cùng bên phải -->
        <Button Content="✕ Đóng dịch (Click vào màn hình để tắt)" 
                Click="CloseButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="20" Padding="12,6" 
                Background="#EE222222" Foreground="#FFFFFF"
                CornerRadius="15" FontSize="11" FontWeight="Bold"/>
    </Grid>
</Window>
